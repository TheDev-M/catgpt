# ==========================
# Spring profile
# ==========================
# Use `prod` anywhere with a real database: it runs Flyway migrations and makes
# Hibernate validate the schema instead of mutating it.
SPRING_PROFILES_ACTIVE=prod

# ==========================
# Database Configuration
# ==========================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/catgpt
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# ==========================
# JWT Configuration
# ==========================
# Must be at least 32 characters (HS256). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=3600000  # milliseconds

# ==========================
# Google OAuth2 Configuration
# ==========================
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# URL of the React frontend, used to redirect back after Google login
FRONTEND_URL=http://localhost:5173

# ==========================
# CORS
# ==========================
# Origins allowed to call the API from a browser, comma-separated.
# FRONTEND_URL is allowed by default, so a single-frontend deployment can leave
# this unset. Set it only to allow additional origins.
# CORS_ALLOWED_ORIGINS=https://example.com,https://other.example.com

# ==========================
# External API Keys
# ==========================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b       # optional, overrides the default chat model
THE_CAT_API_KEY=your_thecatapi_key_here  # optional, increases rate limits
